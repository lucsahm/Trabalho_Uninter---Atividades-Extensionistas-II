    {
      "parameters": {
        "functionCode": "// == CONFIG ==\nconst CORPO_NODE_NAME = \"Download corpoEmail\"; // nó que baixa corpoEmail.txt\n\n// pegar linha atual\nconst incoming = items[0].json || {};\nlet nome = incoming.nome || '';\nlet aptoRaw = incoming.apto || '';\nconst pad = a => a ? a.toString().padStart(3,'0') : '';\nconst apt = pad(aptoRaw);\n\n// carregar arquivo .txt do nó Download corpoEmail\nlet corpoText = '';\ntry {\n    const itemsCorpo = $node[CORPO_NODE_NAME].items; // array de items\n    if (itemsCorpo && itemsCorpo.length > 0 && itemsCorpo[0].binary && itemsCorpo[0].binary.data) {\n        const binData = itemsCorpo[0].binary.data.data; // base64\n        corpoText = Buffer.from(binData, 'base64').toString('utf8');\n    }\n} catch(e) {\n    corpoText = '';\n}\n\n// fallback caso não tenha arquivo\nif (!corpoText) {\n    corpoText = `<p>Olá {{nome}},</p>\n\n<p>Seguem anexos o boleto e o relatório mensal do condomínio referentes a <b>{{mesano}}</b>.</p>\n\n<p>Pedimos que confira os arquivos e, caso perceba qualquer divergência ou tenha dúvidas, basta responder este e-mail — ficaremos felizes em ajudar.</p>\n\n<p>Obrigado pela atenção e colaboração!</p>\n\n<p>Atenciosamente,<br/>\nLucas Sahm<br/>\nTel: +55 47 98491-2771</p>`;\n}\n\n// substituir placeholders {{nome}}, {{apto}} e {{mesano}}\nconst mesano = new Date().toLocaleString('pt-BR', { month: 'long', year: 'numeric' });\ncorpoText = corpoText.replace(/{{nome}}/g, nome || 'Prezado(a)')\n                     .replace(/{{apto}}/g, apt)\n                     .replace(/{{mesano}}/g, mesano);\n\n// montar saída\nitems[0].json.html = corpoText;\nitems[0].json.nome = nome;\nitems[0].json.apto = apt;\nitems[0].json.subject = `Condomínio ${mesano}${apt ? ' — ' + apt : ''}`;\nitems[0].json._corpo_template_loaded = !!corpoText;\n\nreturn [items[0]];\n"
      },
