      "parameters": {
        "jsCode": "// Se houver arquivos baixados, transforma em campos binários para SMTP\nitems.forEach(item => {\n  if (item.json.data && Array.isArray(item.json.data)) {\n    const files = item.json.data.filter(f => f && f.binary && f.binary.data);\n    if (files.length > 0) {\n      item.binary = {};\n      files.forEach((f, index) => {\n        // cada anexo vira data, data_1, data_2...\n        item.binary[`data${index === 0 ? '' : '_' + index}`] = f.binary.data;\n      });\n    }\n  }\n});\nreturn items;"
      },
