    {
      "parameters": {
        "jsCode": "const mergeItem = $('Merge1').first().json; \nlet fileIds = [];\n\nconst fileArray = mergeItem.data;\n\nif (Array.isArray(fileArray) && fileArray.length > 0) {\n    // 🛑 IMPORTANTE: Retornar um ARRAY de IDs, não uma STRING.\n    fileIds = fileArray\n        .map(file => file.id)\n        .filter(id => id); \n}\n\n// Se não houver IDs, não retorna nada, pulando o nó Delete.\nif (fileIds.length === 0) {\n    return []; \n}\n\n// Retorna uma lista de itens, cada um contendo um único ID\nreturn fileIds.map(id => ({\n    json: {\n        fileId: id\n    }\n}));"
      },
